{
  "name": "insta-ai-agent",
  "version": "1.0.0",
  "description": "smart100X Platform",
  "scripts": {
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build && cd .. && node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', {recursive: true, force: true}); fs.cpSync('client/dist', 'dist', {recursive: true})\""
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-jsx": "^5.3.2",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.0-beta.1",
    "openai": "^4.68.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "rimraf": "^6.1.3"
  }
}
